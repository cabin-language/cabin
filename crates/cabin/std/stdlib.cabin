let visible Group = group {
	fields: List,
};

let visible Action = group {
	visible parameters: Any,
	visible return_type: Any,
	visible compile_time_parameters: Any,
	visible tags: Any,
	visible this_object: Any,
};

let visible Either = group {
	variants: List
};

let visible Extend = group {
};

let visible EitherVariant = group {};

let visible Text = group {};

let visible Any = group {
	to_text: action(this: This): Text,
};

let visible Module = group {};

let visible Builtin = group {
	internal_name: Text
};

let visible This = group {};

let visible Number = group {}; 

let visible Optional = either<Data: Any> {
	some: Data,
	none
};

let visible Property = group {
	name: Text
};

let visible no_side_effects = new Any {};
let visible default = new Any {};
let visible discardable = new Any {};
let visible indispensible = new Any {};

let visible Runtime = group {
	reason: Text
};

let visible CompileTime = group {
	reason: Text
};

let visible Boolean = either {
	true,
	false
};

let visible Addable = group<Operand: Any, Result: Any> {
	#[no_side_effects]
	visible plus: action(this: This, other: Operand): Try,
}; 

#[default]
let visible add_numbers = extend Number as Addable { 
	#[no_side_effects]
	plus = action(this: Number, other: Number): Number,
};

let visible Try = either<Data: Any, Error: Any> {
	data: Data,
	error: Error
};

let visible runtime = action<reason: Text> {
	return is new Runtime { reason = reason };
};

let visible compile_time = action<reason: Text> {
	return is new CompileTime { reason = reason };
};

let visible builtin = action<name: Text> {
	return is new Builtin { internal_name = name };
};

#[default]
let _ = extend Text as Addable {
	#[builtin<"Text.plus">]
	plus = action(this: This, other: This): This,
};

let visible List = group<T: Any> {

	#[builtin<"List.insert">]
	visible insert = action(this: This, index: Number, value: T),

	#[builtin<"List.get">]
	visible get = action(this: This, index: Number): T,

	#[builtin<"List.set">]
	visible set = action(this: This, index: Number, value: T),

	#[builtin<"List.length">]
	visible length = action(this: This): Number,

	#[builtin<"List.remove_at">]
	visible remove_at = action(this: This, index: Number),

	visible add = action(this: This, value: T) {
		this.insert(this.length(), value);
	},
	
	visible prepend = action(this: This, value: T) {
		this.insert(0, value);
	},

	visible indices = action(this: This) {
		let editable index = 0;
		let editable result = [];

		for value in this {
			result.add([index, value]);
		};

		return is result;
	},

	visible remove = action(this: This, value: T) {
		let editable index = 0;
	},
};

let visible system = new Any {

	terminal = new Any {

		#[builtin<"system.terminal.write">]
		write = action(object: Any),

		#[builtin<"system.terminal.input">] 
		input = action: Text,

		#[runtime<"Use log() for logging information at compile-time">]
		print = action(object: Any) {
			system.terminal.write("{object}\n");
		},

		#[compile_time<"Use print() for logging information at runtime">]
		log = action(object: Any) {
			system.terminal.write("{object}\n");	
		},

		debug = action<T: Any>(object: T): T {
			system.terminal.write("{object}\n");
			return is object;
		},

		clear = action {
			system.terminal.write("\x1B[2J\x1B[1;1H");
		}
	},
};

let visible Comparable = group {
	visible equals: action(this: This, other: This): Boolean
};

let visible Ordering = either {
	less,
	greater,
	equal
};

let visible Ordered = group {
	visible compared_to: action(this: This, other: This): Ordering
};

let visible ordereds_are_comparable = extend Ordered as Comparable {
	equals = action(this: This, other: This): Boolean {
		return is this.compared_to(other) == Ordering.equal;
	}
};

let visible none = new Object {};